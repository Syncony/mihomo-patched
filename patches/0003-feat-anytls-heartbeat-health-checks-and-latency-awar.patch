diff --git a/transport/anytls/session/health.go b/transport/anytls/session/health.go
new file mode 100644
index 00000000..f88df60a
--- /dev/null
+++ b/transport/anytls/session/health.go
@@ -0,0 +1,234 @@
+package session
+
+import (
+	"math/rand"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	// extKey is sent in the client's settings and echoed in the server's by peers
+	// that run this patch; peers without it ignore unknown keys.
+	extKey   = "x-hk"
+	extValue = "1"
+
+	healthTick = 500 * time.Millisecond
+	// Idle sessions are pinged at a random interval in [pingInterval, pingInterval+pingJitter),
+	// so heartbeats neither keep a mobile radio awake nor form a regular pattern.
+	pingInterval = 10 * time.Second
+	pingJitter   = 20 * time.Second
+	// A reply is overdue after TCP's retransmission timeout (RFC 6298: SRTT + 4·RTTVAR)
+	// but never under replyRoundTrips smoothed round trips, kept within
+	// minReplyDeadline and maxReplyDeadline, and minReplyDeadline until measured.
+	// The floor matches the fixed 3s SYNACK deadline of the unpatched client.
+	minReplyDeadline = 3 * time.Second
+	maxReplyDeadline = 10 * time.Second
+	replyRoundTrips  = 5
+	// Expected waits within this band of the best, or a quarter of it, count as tied.
+	minWaitBand = 20 * time.Millisecond
+
+	// Dynamic record sizing for server writes: after an idle second a burst starts
+	// with frames that fit one TCP segment inside one TLS record and grows by a
+	// segment per frame up to a full TLS record.
+	drsSegment   = 1208 - 22 - headerOverHeadSize // Go's TLS MSS estimate minus TLS 1.3 and frame overhead
+	drsMax       = 16384 - headerOverHeadSize
+	drsIdleReset = time.Second
+)
+
+type sessionHealth struct {
+	lastRecv atomic.Int64 // unix nanoseconds of the last frame received
+	synSent  atomic.Int64 // unix nanoseconds of the SYN still waiting for its SYNACK
+	latest   atomic.Int64 // latest round trip in nanoseconds; 0 until the first
+	pinging  atomic.Bool
+
+	mu       sync.Mutex
+	pings    map[uint32]time.Time // pings still waiting for their response
+	nextPing uint32
+	pingAt   time.Time // when the next ping is due; zero pings at once
+	srtt     time.Duration
+	rttvar   time.Duration
+
+	drsMu    sync.Mutex
+	drsLimit int
+	drsLast  time.Time
+}
+
+func (s *Session) sample(rtt time.Duration) {
+	// Zero means unmeasured; a coarse clock can read a LAN round trip as zero.
+	rtt = maxDur(rtt, time.Microsecond)
+	h := &s.health
+	h.latest.Store(int64(rtt))
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.srtt == 0 {
+		h.srtt, h.rttvar = rtt, rtt/2
+		return
+	}
+	diff := h.srtt - rtt
+	if diff < 0 {
+		diff = -diff
+	}
+	h.rttvar += (diff - h.rttvar) / 4
+	h.srtt += (rtt - h.srtt) / 8
+}
+
+func (s *Session) replyDeadline() time.Duration {
+	h := &s.health
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.srtt == 0 {
+		return minReplyDeadline
+	}
+	return minDur(maxDur(maxDur(h.srtt+4*h.rttvar, replyRoundTrips*h.srtt), minReplyDeadline), maxReplyDeadline)
+}
+
+// ping sends a heartbeat request whose stream id field carries the ping id.
+func (s *Session) ping() {
+	if !s.health.pinging.CompareAndSwap(false, true) {
+		return
+	}
+	defer s.health.pinging.Store(false)
+	h := &s.health
+	h.mu.Lock()
+	if h.pings == nil {
+		h.pings = make(map[uint32]time.Time)
+	}
+	id := h.nextPing
+	h.nextPing++
+	now := time.Now()
+	h.pings[id] = now
+	h.pingAt = now.Add(pingInterval + time.Duration(rand.Int63n(int64(pingJitter))))
+	h.mu.Unlock()
+	s.writeControlFrame(newFrame(cmdHeartRequest, id))
+}
+
+// pong settles ping id and every older one, as the peer answers in order.
+func (s *Session) pong(id uint32) {
+	h := &s.health
+	h.mu.Lock()
+	sent, ok := h.pings[id]
+	for older := range h.pings {
+		if older <= id {
+			delete(h.pings, older)
+		}
+	}
+	h.mu.Unlock()
+	if ok {
+		s.sample(time.Since(sent))
+	}
+}
+
+// pingDue reports whether an idle session should be pinged: once its random interval
+// since the last ping has passed.
+func (s *Session) pingDue(now time.Time) bool {
+	if s.peerVersion < 2 {
+		return false // heartbeats arrived with version 2
+	}
+	s.health.mu.Lock()
+	at := s.health.pingAt
+	s.health.mu.Unlock()
+	return !now.Before(at)
+}
+
+// unresponsive reports whether a ping has waited past the reply deadline while
+// nothing else arrived for as long.
+func (s *Session) unresponsive(now time.Time) bool {
+	d := s.replyDeadline()
+	if now.Sub(time.Unix(0, s.health.lastRecv.Load())) < d {
+		return false
+	}
+	h := &s.health
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	for _, sent := range h.pings {
+		if now.Sub(sent) >= d {
+			return true
+		}
+	}
+	return false
+}
+
+// expectedWait estimates how long a new stream would wait for a reply: the latest
+// round trip, or longer while a ping has gone unanswered for longer. It is negative
+// while neither is known.
+func (s *Session) expectedWait(now time.Time) time.Duration {
+	wait := time.Duration(-1)
+	if latest := s.health.latest.Load(); latest != 0 {
+		wait = time.Duration(latest)
+	}
+	h := &s.health
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	for _, sent := range h.pings {
+		wait = maxDur(wait, now.Sub(sent))
+	}
+	return wait
+}
+
+// choose returns the index of the first candidate, in preference order, whose
+// expected wait is unknown or within the band of the best known one.
+func choose(waits []time.Duration) int {
+	fastest := time.Duration(-1)
+	for _, w := range waits {
+		if w >= 0 && (fastest < 0 || w < fastest) {
+			fastest = w
+		}
+	}
+	limit := fastest + maxDur(fastest/4, minWaitBand)
+	for i, w := range waits {
+		if fastest < 0 || w <= limit {
+			return i
+		}
+	}
+	return -1
+}
+
+// writeDataFrameDRS writes small frames first after the session was idle, so the
+// receiver can decrypt the first TLS records of a response without waiting for a
+// full 16 KiB one.
+func (s *Session) writeDataFrameDRS(sid uint32, data []byte) (int, error) {
+	h := &s.health
+	h.drsMu.Lock()
+	defer h.drsMu.Unlock()
+	now := time.Now()
+	if h.drsLimit == 0 || now.Sub(h.drsLast) > drsIdleReset {
+		h.drsLimit = drsSegment
+	}
+	h.drsLast = now
+	written := 0
+	for written < len(data) && h.drsLimit < drsMax {
+		size := len(data) - written
+		if size > h.drsLimit {
+			size = h.drsLimit
+		}
+		n, err := s.writeFrames(sid, data[written:written+size])
+		written += n
+		if err != nil {
+			return written, err
+		}
+		h.drsLimit += drsSegment
+		if h.drsLimit > drsMax {
+			h.drsLimit = drsMax
+		}
+	}
+	if written < len(data) {
+		n, err := s.writeFrames(sid, data[written:])
+		return written + n, err
+	}
+	return written, nil
+}
+
+func minDur(a, b time.Duration) time.Duration {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+func maxDur(a, b time.Duration) time.Duration {
+	if a > b {
+		return a
+	}
+	return b
+}
