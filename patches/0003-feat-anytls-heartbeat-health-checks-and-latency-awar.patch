+package session
+
+import (
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/anytls/padding"
+)
+
+func TestReplyDeadlineBounds(t *testing.T) {
+	var s Session
+	if d := s.replyDeadline(); d != minReplyDeadline {
+		t.Fatalf("unmeasured deadline = %v, want %v", d, minReplyDeadline)
+	}
+	s.sample(20 * time.Millisecond)
+	if d := s.replyDeadline(); d != minReplyDeadline {
+		t.Fatalf("fast link deadline = %v, want floor %v", d, minReplyDeadline)
+	}
+	var slow Session
+	slow.sample(5 * time.Second)
+	if d := slow.replyDeadline(); d != maxReplyDeadline {
+		t.Fatalf("slow link deadline = %v, want cap %v", d, maxReplyDeadline)
+	}
+}
+
+func TestPingIntervalJitter(t *testing.T) {
+	c, peer := net.Pipe()
+	defer c.Close()
+	defer peer.Close()
+	go io.Copy(io.Discard, peer)
+
+	s := &Session{conn: c, peerVersion: 2, die: make(chan struct{})}
+	now := time.Now()
+	if !s.pingDue(now) {
+		t.Fatal("a session never pinged should be due")
+	}
+	seen := map[time.Duration]bool{}
+	for i := 0; i < 20; i++ {
+		before := time.Now()
+		s.ping()
+		s.health.mu.Lock()
+		gap := s.health.pingAt.Sub(before)
+		s.health.mu.Unlock()
+		if gap < pingInterval || gap > pingInterval+pingJitter+time.Second {
+			t.Fatalf("next ping in %v, want within [%v, %v)", gap, pingInterval, pingInterval+pingJitter)
+		}
+		if s.pingDue(before.Add(pingInterval - time.Second)) {
+			t.Fatal("ping due before the minimum interval")
+		}
+		seen[gap.Round(time.Second)] = true
+	}
+	if len(seen) < 2 {
+		t.Fatal("ping interval is not randomized")
+	}
+}
+
+// newSessionPair connects a client and a server session over a pipe. Every stream
+// the server accepts is handed to onStream after its SYNACK decision is left to it.
+func newSessionPair(t *testing.T, onStream func(*Stream)) (*Session, *Session) {
+	t.Helper()
+	var pad atomic.Pointer[padding.PaddingFactory]
+	padding.UpdatePaddingScheme(padding.DefaultPaddingScheme, &pad)
+	cConn, sConn := net.Pipe()
+	server := NewServerSession(sConn, onStream, &pad)
+	go server.Run()
+	client := NewClientSession(cConn, &pad, "test")
+	client.Run()
+	t.Cleanup(func() {
+		client.Close()
+		server.Close()
+	})
+	return client, server
+}
+
+// openFirst opens stream 1 and waits for its echo, so settings are exchanged.
+func openFirst(t *testing.T, client *Session) *Stream {
+	t.Helper()
+	s1, err := client.OpenStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s1.Write([]byte("ping")); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 4)
+	if _, err := io.ReadFull(s1, buf); err != nil {
+		t.Fatal(err)
+	}
+	if !client.peerExt.Load() {
+		t.Fatal("server did not confirm the extension")
+	}
+	return s1
+}
+
+func TestSlowSynAckKeepsLiveSession(t *testing.T) {
+	stop := make(chan struct{})
+	defer close(stop)
+	client, _ := newSessionPair(t, func(st *Stream) {
+		if st.id != 1 {
+			// Acknowledge only well past the deadline.
+			select {
+			case <-time.After(minReplyDeadline + 2*time.Second):
+				_ = st.HandshakeSuccess()
+			case <-stop:
+			}
+			return
+		}
+		_ = st.HandshakeSuccess()
+		buf := make([]byte, 4)
+		if _, err := io.ReadFull(st, buf); err != nil {
+			return
+		}
+		_, _ = st.Write(buf)
+		// Keep stream 1 busy, as a download would.
+		for {
+			select {
+			case <-stop:
+				return
+			case <-time.After(200 * time.Millisecond):
+			}
+			if _, err := st.Write([]byte("data")); err != nil {
+				return
+			}
+		}
+	})
+	s1 := openFirst(t, client)
+	go io.Copy(io.Discard, s1)
+
+	if _, err := client.OpenStream(); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(minReplyDeadline + time.Second)
+	if client.IsClosed() {
+		t.Fatal("session with a busy stream was closed for one slow SYNACK")
+	}
+}
+
+func TestSilentSessionClosesAfterDeadline(t *testing.T) {
+	client, _ := newSessionPair(t, func(st *Stream) {
+		if st.id != 1 {
+			return // never acknowledged, and nothing else is sent
+		}
+		_ = st.HandshakeSuccess()
+		buf := make([]byte, 4)
+		if _, err := io.ReadFull(st, buf); err == nil {
+			_, _ = st.Write(buf)
+		}
+	})
+	openFirst(t, client)
+
+	if _, err := client.OpenStream(); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(minReplyDeadline + 2*time.Second)
+	for !client.IsClosed() {
+		if time.Now().After(deadline) {
+			t.Fatal("silent session was not closed after the SYNACK deadline")
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+}
