+// getIdleSession takes the idle session expected to answer soonest, preferring the
+// newest among those tied, and skips any whose heartbeat is overdue.
 func (c *Client) getIdleSession() (idle *Session) {
+	now := time.Now()
+	var keys []uint64
+	var sessions []*Session
+	var waits []time.Duration
 	c.idleSessionLock.Lock()
-	if !c.idleSession.IsEmpty() {
-		it := c.idleSession.Iterate()
-		idle = it.Value()
-		c.idleSession.Remove(it.Key())
+	for it := c.idleSession.Iterate(); it.IsNotEnd(); it.MoveToNext() {
+		session := it.Value()
+		if session.unresponsive(now) {
+			continue // healthCheck closes it
+		}
+		keys = append(keys, it.Key())
+		sessions = append(sessions, session)
+		waits = append(waits, session.expectedWait(now))
+	}
+	if i := choose(waits); i >= 0 {
+		idle = sessions[i]
+		c.idleSession.Remove(keys[i])
 	}
 	c.idleSessionLock.Unlock()
 	return
 }
 
+// healthCheck pings idle sessions and closes those that stopped answering, so a
+// request never lands on a session that died while it sat in the pool.
+func (c *Client) healthCheck() {
+	now := time.Now()
+	var dead, due []*Session
+	c.idleSessionLock.Lock()
+	for it := c.idleSession.Iterate(); it.IsNotEnd(); {
+		key, session := it.Key(), it.Value()
+		it.MoveToNext()
+		if session.unresponsive(now) {
+			c.idleSession.Remove(key)
+			dead = append(dead, session)
+		} else if session.pingDue(now) {
+			due = append(due, session)
+		}
+	}
+	c.idleSessionLock.Unlock()
+	for _, session := range dead {
+		session.Close()
+	}
+	for _, session := range due {
+		// A stuck write must not hold up the other sessions' checks.
+		go session.ping()
+	}
+}
