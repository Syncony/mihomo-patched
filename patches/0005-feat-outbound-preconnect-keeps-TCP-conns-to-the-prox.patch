diff --git a/adapter/outbound/warm.go b/adapter/outbound/warm.go
new file mode 100644
index 00000000..28e3d95e
--- /dev/null
+++ b/adapter/outbound/warm.go
@@ -0,0 +1,231 @@
+package outbound
+
+import (
+	"context"
+	"net"
+	"sync"
+	"time"
+
+	N "github.com/metacubex/mihomo/common/net"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+const (
+	warmMaxAge     = 15 * time.Second // pooled conns older than this are closed and replaced
+	warmRefillTick = 200 * time.Millisecond
+	warmErrBackoff = 2 * time.Second
+	// A pooled conn the server closed sooner than this is taken as a network blip,
+	// not as the server's idle limit.
+	warmMinLifetime = time.Second
+	// The pool stops refilling and drops its conns after this long without a dial
+	// from real traffic.
+	warmIdleStop = 15 * time.Second
+)
+
+// warmDialer keeps up to size connected TCP conns to the proxy server while the
+// proxy carries real traffic, so a new connection skips the TCP handshake. The
+// server address is the first one dialed over tcp by real traffic; dials to other
+// addresses, packet dials and delay tests pass through.
+type warmDialer struct {
+	C.Dialer
+	size int
+
+	mu       sync.Mutex
+	addr     string
+	conns    []warmEntry
+	filling  bool
+	inflight int
+	errUntil time.Time
+	lastUse  time.Time
+	lifetime time.Duration // shortest time the server was seen to keep an idle conn; 0 until seen
+}
+
+type warmEntry struct {
+	conn   net.Conn
+	probe  bool   // conn is a local socket, so a read only sees the server
+	cached []byte // read by probes, handed back before anything else
+	at     time.Time
+}
+
+// newWarmDialer wraps d unless preconnect is off. A TCP Fast Open dial connects on
+// its first write, so a pooled one would not be connected.
+func newWarmDialer(d C.Dialer, option *BasicOption) C.Dialer {
+	if option.Preconnect <= 0 || option.TFO {
+		return d
+	}
+	return &warmDialer{Dialer: d, size: option.Preconnect}
+}
+
+func (w *warmDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	if network != "tcp" || C.IsHealthCheck(ctx) {
+		return w.Dialer.DialContext(ctx, network, address)
+	}
+	w.mu.Lock()
+	if w.addr == "" {
+		w.addr = address
+	}
+	if address != w.addr {
+		w.mu.Unlock()
+		return w.Dialer.DialContext(ctx, network, address)
+	}
+	w.lastUse = time.Now()
+	if !w.filling {
+		w.filling = true
+		go w.fill()
+	}
+	c := w.takeLocked()
+	w.mu.Unlock()
+	if c != nil {
+		return c, nil
+	}
+	return w.Dialer.DialContext(ctx, network, address)
+}
+
+// takeLocked returns a live pooled conn, newest first, or nil.
+func (w *warmDialer) takeLocked() net.Conn {
+	now := time.Now()
+	for n := len(w.conns); n > 0; n = len(w.conns) {
+		e := &w.conns[n-1]
+		w.conns = w.conns[:n-1]
+		if w.aliveLocked(e, now) {
+			if len(e.cached) > 0 {
+				return N.NewCachedConn(e.conn, e.cached)
+			}
+			return e.conn
+		}
+		_ = e.conn.Close()
+	}
+	return nil
+}
+
+func (w *warmDialer) fill() {
+	for {
+		w.mu.Lock()
+		now := time.Now()
+		if now.Sub(w.lastUse) > warmIdleStop {
+			conns := w.conns
+			w.conns = nil
+			w.filling = false
+			w.mu.Unlock()
+			for _, e := range conns {
+				_ = e.conn.Close()
+			}
+			return
+		}
+		// Evict conns that aged out or that the server already closed, so the pool
+		// is refilled now instead of handing out a dead conn later.
+		kept := w.conns[:0]
+		for i := range w.conns {
+			e := w.conns[i]
+			if w.aliveLocked(&e, now) {
+				kept = append(kept, e)
+			} else {
+				_ = e.conn.Close()
+			}
+		}
+		w.conns = kept
+		need := 0
+		if now.After(w.errUntil) {
+			need = w.size - len(w.conns) - w.inflight
+		}
+		if need > 0 {
+			w.inflight += need
+		}
+		addr := w.addr
+		w.mu.Unlock()
+
+		for i := 0; i < need; i++ {
+			go w.prepareOne(addr)
+		}
+		time.Sleep(warmRefillTick)
+	}
+}
+
+func (w *warmDialer) prepareOne(addr string) {
+	ctx, cancel := context.WithTimeout(context.Background(), C.DefaultTCPTimeout)
+	c, err := w.Dialer.DialContext(ctx, "tcp", addr)
+	cancel()
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.inflight--
+	if err != nil {
+		w.errUntil = time.Now().Add(warmErrBackoff)
+		return
+	}
+	if !w.filling {
+		_ = c.Close()
+		return
+	}
+	w.conns = append(w.conns, warmEntry{conn: c, probe: isLocalSocket(c), at: time.Now()})
+}
+
+// maxAgeLocked recycles conns at 80% of the learned server idle limit, never later
+// than warmMaxAge.
+func (w *warmDialer) maxAgeLocked() time.Duration {
+	if w.lifetime == 0 || w.lifetime*4/5 > warmMaxAge {
+		return warmMaxAge
+	}
+	return w.lifetime * 4 / 5
+}
+
+// aliveLocked reports whether the pooled conn is young enough and not closed by the
+// server, learning the server's idle limit from conns it closed.
+func (w *warmDialer) aliveLocked(e *warmEntry, now time.Time) bool {
+	age := now.Sub(e.at)
+	if age > w.maxAgeLocked() {
+		if w.lifetime > 0 {
+			// Survived to the limit: let the estimate creep back up in case the
+			// shortest one was a fluke.
+			w.lifetime += w.lifetime / 16
+			if w.lifetime*4/5 > warmMaxAge {
+				w.lifetime = 0 // no longer binding
+			}
+		}
+		return false
+	}
+	if !e.probe {
+		return true
+	}
+	// An already expired deadline fails the read before the socket is looked at,
+	// so give it a moment to report a FIN or RST that has arrived.
+	var buf [2048]byte
+	_ = e.conn.SetReadDeadline(time.Now().Add(time.Millisecond))
+	n, err := e.conn.Read(buf[:])
+	_ = e.conn.SetReadDeadline(time.Time{})
+	if n > 0 {
+		// Some servers speak first, as an SSH server sends its banner. Keep what
+		// was read for the user of the conn and look again next time.
+		e.cached = append(e.cached, buf[:n]...)
+		return true
+	}
+	if ne, ok := err.(net.Error); ok && ne.Timeout() {
+		return true
+	}
+	if age >= warmMinLifetime && (w.lifetime == 0 || age < w.lifetime) {
+		w.lifetime = age
+	}
+	return false
+}
+
+type upstreamConn interface {
+	Upstream() any
+}
+
+// isLocalSocket reports whether c is a TCP socket of this host, maybe wrapped.
+// Conns from a dialer-proxy are not, and may parse their own response lazily.
+func isLocalSocket(c net.Conn) bool {
+	for c != nil {
+		switch c.(type) {
+		case *net.TCPConn:
+			return true
+		case C.Conn:
+			return false
+		}
+		u, ok := c.(upstreamConn)
+		if !ok {
+			return false
+		}
+		c, _ = u.Upstream().(net.Conn)
+	}
+	return false
+}
diff --git a/constant/healthcheck.go b/constant/healthcheck.go
new file mode 100644
index 00000000..de879dba
--- /dev/null
+++ b/constant/healthcheck.go
@@ -0,0 +1,16 @@
+package constant
+
+import "context"
+
+type healthCheckKey struct{}
+
+// WithHealthCheck marks ctx as carrying a delay test rather than user traffic.
+func WithHealthCheck(ctx context.Context) context.Context {
+	return context.WithValue(ctx, healthCheckKey{}, true)
+}
+
+// IsHealthCheck reports whether ctx was marked by WithHealthCheck.
+func IsHealthCheck(ctx context.Context) bool {
+	v, _ := ctx.Value(healthCheckKey{}).(bool)
+	return v
+}
