 func (c *Client) CreateProxy(ctx context.Context, destination M.Socksaddr) (net.Conn, error) {
+	stream, err := c.createStream(ctx, destination)
+	if err != nil {
+		return nil, err
+	}
+	r := &replayConn{client: c, destination: destination}
+	r.stream.Store(stream)
+	return r, nil
+}
+
+func (c *Client) createStream(ctx context.Context, destination M.Socksaddr) (*session.Stream, error) {
 	conn, err := c.sessionClient.CreateStream(ctx)
 	if err != nil {
 		return nil, err
@@ -62,7 +72,7 @@ func (c *Client) CreateProxy(ctx context.Context, destination M.Socksaddr) (net.
 		conn.Close()
 		return nil, err
 	}
-	return conn, nil
+	return conn.(*session.Stream), nil
 }
 
